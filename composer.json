{
    "name": "zenbu/power-agreement",
    "description": "WooCommerce checkout agreement consent plugin with HPOS-safe order snapshot.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.1",
        "composer/installers": "^2.2",
        "yahnis-elsts/plugin-update-checker": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.5",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^9.0",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-cli/i18n-command": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "PowerAgreement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PowerAgreement\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit --colors=always --testsuite=unit",
        "test:integration": "POWER_AGREEMENT_LOAD_WP=1 phpunit --colors=always --testsuite=integration",
        "test:integration:hpos": "POWER_AGREEMENT_LOAD_WP=1 POWER_AGREEMENT_HPOS=on phpunit --colors=always --testsuite=integration",
        "test:integration:legacy": "POWER_AGREEMENT_LOAD_WP=1 POWER_AGREEMENT_HPOS=off phpunit --colors=always --testsuite=integration",
        "lint": [
            "@lint:phpcs",
            "@lint:phpstan"
        ],
        "lint:phpcs": "phpcs --standard=phpcs.xml.dist",
        "lint:phpstan": "phpstan analyse --memory-limit=1G",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
