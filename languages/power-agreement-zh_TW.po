#: src/Settings/SettingsPage.php:62
msgid "Checkout Agreement"
msgstr "結帳合約"

#: src/Settings/SettingsPage.php:69
msgid "Enable agreement on checkout"
msgstr "啟用結帳合約"

#: src/Settings/SettingsPage.php:77
msgid "Section title"
msgstr "區塊標題"

#: src/Settings/SettingsPage.php:85
msgid "Agreement body"
msgstr "合約內容"

#: src/Settings/SettingsPage.php:93
