#. Plugin Name
msgid "Power Agreement"
msgstr "Power Agreement 結帳合約"

#. Description
msgid "Adds a configurable agreement consent block to WooCommerce checkout (Classic + Block) and stores a per-order snapshot for legal evidence."
msgstr "在 WooCommerce 結帳頁（傳統與區塊兩種）加入可設定的合約同意區塊，並為每筆訂單保留一份合約快照作為法律佐證。"

msgid "Power Agreement: Composer dependencies are missing. Run \"composer install\" inside the plugin directory."
msgstr "Power Agreement：找不到 Composer 套件，請在外掛目錄執行 \"composer install\"。"

msgid "Power Agreement is not active:"
msgstr "Power Agreement 未啟用："

msgid "Whether the customer has accepted the agreement."
msgstr "客戶是否已同意合約。"

msgid "Please check \"%s\" to place your order."
msgstr "請先勾選「%s」後再下單。"

msgid "Agreement Consent"
msgstr "合約同意紀錄"

msgid "No agreement consent record on this order."
msgstr "本訂單沒有合約同意紀錄。"

msgid "Agreed at:"
msgstr "同意時間："

msgid "Customer IP:"
msgstr "客戶 IP："

msgid "SHA-256:"
msgstr "SHA-256："

msgid "View captured agreement HTML"
msgstr "查看當下合約全文"

msgid "Checkout Agreement"
msgstr "結帳合約"

msgid "Enable agreement on checkout"
msgstr "啟用結帳合約"

msgid "Section title"
msgstr "區塊標題"

msgid "Agreement body"
msgstr "合約內容"

msgid "Consent checkbox label"
msgstr "同意勾選文字"

msgid "Agreement is enabled but the body is empty — checkout will skip rendering until you add some content."
msgstr "合約已啟用但內容為空，在補上內容前結帳頁不會顯示合約。"

msgid "Configure the agreement that customers must accept before placing an order."
msgstr "設定客戶必須同意才能下單的合約內容。"

msgid "Show the agreement section on checkout and require consent."
msgstr "在結帳頁顯示合約區塊並要求同意。"

msgid "Agreement"
msgstr "合約條款"

msgid "I have read and agree to the agreement above."
msgstr "我已閱讀並同意上述合約。"
