#. Plugin Name of the plugin
#: power-agreement.php:3 src/Settings/SettingsPage.php:41
#: src/Settings/SettingsPage.php:42 assets/build/index.js:1
msgid "Power Agreement"
msgstr "Power Agreement 結帳合約"

#. Plugin URI of the plugin
#: power-agreement.php:4
msgid "https://github.com/zenbuapps/power-agreement"
msgstr ""

#. Description of the plugin
#: power-agreement.php:5
msgid ""
"Adds a configurable agreement consent block to WooCommerce checkout (Classic "
"+ Block) and stores a per-order snapshot for legal evidence."
msgstr ""
"在 WooCommerce 結帳頁（傳統與區塊兩種）加入可設定的合約同意區塊，並為每筆訂單"
"保留一份合約快照作為法律佐證。"

#. Author of the plugin
#: power-agreement.php:10
msgid "Zenbu"
msgstr ""

#. Author URI of the plugin
#: power-agreement.php:11
msgid "https://zenbu.tw"
msgstr ""

#: power-agreement.php:42
msgid ""
"Power Agreement: Composer dependencies are missing. Run \"composer install\" "
"inside the plugin directory."
msgstr ""
"Power Agreement：找不到 Composer 套件，請在外掛目錄執行 \"composer "
"install\"。"

